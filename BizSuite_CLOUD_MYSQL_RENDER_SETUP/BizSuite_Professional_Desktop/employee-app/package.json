{
  "name": "bizsuite-employee",
  "version": "1.3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.bizsuite.employee",
    "productName": "BizSuite Employee",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "index.html",
      "server-config-preload.js",
      "server-config.html",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/bizsuite.ico",
      "artifactName": "BizSuite-Employee-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BizSuite Employee",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutIcon": "assets/bizsuite.ico",
      "installerIcon": "assets/bizsuite.ico",
      "uninstallerIcon": "assets/bizsuite.ico"
    },
    "artifactName": "BizSuite-Employee-Setup-${version}.${ext}"
  },
  "description": "BizSuite Employee — Professional Desktop"
}
